set -euo pipefail

BCRAFT_VERSION="0.6.0"

BASECRAFT_LIB="/var/lib/basecraft"
BASECRAFT_CACHE="/var/cache/basecraft"

BUILDROOT="$BASECRAFT_LIB/build"
DBROOT="$BASECRAFT_LIB/packages"

SOURCECACHE="$BASECRAFT_CACHE/sources"
PACKAGECACHE="$BASECRAFT_CACHE/packages"


die()
{
    echo "bcraft: $*" >&2
    exit 1
}


usage()
{
    cat <<EOF
Usage:

  bcraft build <package.src.bcraft>
  bcraft src-build [recipe-dir]
  bcraft install [--nodeps] <package.bcraft>
  bcraft update [--nodeps] <package.bcraft>
  bcraft remove <package>
  bcraft list
  bcraft info <package>

  bcraft -v
  bcraft --version
  bcraft -h
  bcraft --help

EOF
}


version()
{
    echo "bcraft $BCRAFT_VERSION"
}


require_root()
{
    if [ "$(id -u)" -ne 0 ]; then
        die "This operation must be run as root"
    fi
}


metadata()
{
    local file="$1"
    local key="$2"

    sed -n "s/^${key}=//p" "$file" | head -n 1
}


metadata_all()
{
    local file="$1"
    local key="$2"

    sed -n "s/^${key}=//p" "$file"
}


#
# Return true when PATH is a configuration file.
#
# Rules:
#   - regular files below etc/ are config automatically
#   - additional exact paths can be listed in config_files=(...)
#     in package.conf
#
is_config_path()
{
    local path="$1"
    local item

    case "$path" in
        etc/*)
            return 0
            ;;
    esac

    if declare -p config_files >/dev/null 2>&1; then
        for item in "${config_files[@]}"
        do
            item="${item#/}"

            if [ "$path" = "$item" ]; then
                return 0
            fi
        done
    fi

    return 1
}


#
# New manifest format:
#
#   TYPE<TAB>SHA256-or--<TAB>PATH
#
# TYPE:
#   f  regular file
#   c  configuration file
#   l  symbolic link
#   d  directory
#
# Older bcraft manifests used:
#
#   TYPE<TAB>PATH
#
# normalize_manifest transparently converts those old manifests.
# Old regular files under etc/ are treated as configuration files,
# but their original package checksum is unknown ("-").
#
normalize_manifest()
{
    local manifest="$1"

    awk -F '\t' '
    NF >= 3 {
        type=$1
        hash=$2
        path=$3

        for (i=4; i<=NF; i++)
            path=path FS $i

        print type "\t" hash "\t" path
        next
    }

    NF == 2 {
        type=$1
        path=$2

        if (type == "f" && path ~ /^etc\//)
            type="c"

        print type "\t-\t" path
    }
    ' "$manifest"
}


manifest_lookup()
{
    local manifest="$1"
    local wanted="$2"

    normalize_manifest "$manifest" |
    awk -F '\t' -v wanted="$wanted" '
        $3 == wanted {
            print $1 "\t" $2 "\t" $3
            exit
        }
    '
}


manifest_has()
{
    local manifest="$1"
    local wanted="$2"

    [ -n "$(manifest_lookup "$manifest" "$wanted")" ]
}


file_sha256()
{
    sha256sum -- "$1" | awk '{print $1}'
}


validate_package_path()
{
    local path="$1"

    case "$path" in
        ""|/*|../*|*/../*|*/..)
            return 1
            ;;
    esac

    return 0
}


check_arch()
{
    local arch="$1"
    local system_arch

    system_arch="$(uname -m)"

    if [ "$arch" != "any" ] &&
       [ "$arch" != "$system_arch" ]; then
        die "Package architecture $arch does not match $system_arch"
    fi
}


check_base()
{
    local base="$1"

    if [ "$base" = "any" ]; then
        return
    fi

    [ -f /etc/basecraft-release ] ||
        die "/etc/basecraft-release missing"

    local system_base
    system_base="$(cat /etc/basecraft-release)"

    [ "$base" = "$system_base" ] ||
        die "Package requires $base, system is $system_base"
}


validate_dependency_name()
{
    local dependency="$1"

    [[ "$dependency" =~ ^[A-Za-z0-9][A-Za-z0-9+_.-]*$ ]]
}


dependency_installed()
{
    local dependency="$1"
    local pkginfo="$DBROOT/$dependency/PKGINFO"

    [ -f "$pkginfo" ] ||
        return 1

    [ "$(metadata "$pkginfo" name)" = "$dependency" ]
}


check_dependencies()
{
    local pkginfo="$1"
    local package_name="$2"
    local nodeps="$3"

    [ "$nodeps" -eq 0 ] ||
        return 0

    local dependency
    local -a missing=()

    while IFS= read -r dependency
    do
        [ -n "$dependency" ] ||
            continue

        if ! validate_dependency_name "$dependency"; then
            echo "bcraft: Invalid dependency name in $package_name: $dependency" >&2
            return 1
        fi

        if ! dependency_installed "$dependency"; then
            missing+=("$dependency")
        fi

    done < <(metadata_all "$pkginfo" depend)

    if [ "${#missing[@]}" -eq 0 ]; then
        return
    fi

    echo "bcraft: Missing dependencies for $package_name:" >&2

    for dependency in "${missing[@]}"
    do
        echo "  $dependency" >&2
    done

    echo "bcraft: Use --nodeps to skip dependency checks" >&2
    return 1
}


parse_package_command_args()
{
    local command="$1"
    shift

    NODEPS=0
    PACKAGE_ARG=""

    while [ "$#" -gt 0 ]
    do
        case "$1" in
            --nodeps)
                NODEPS=1
                ;;

            --)
                shift
                [ "$#" -eq 1 ] ||
                    die "Usage: bcraft $command [--nodeps] <package.bcraft>"
                PACKAGE_ARG="$1"
                shift
                break
                ;;

            -*)
                die "Unknown option for $command: $1"
                ;;

            *)
                [ -z "$PACKAGE_ARG" ] ||
                    die "Usage: bcraft $command [--nodeps] <package.bcraft>"
                PACKAGE_ARG="$1"
                ;;
        esac

        shift
    done

    [ -n "$PACKAGE_ARG" ] ||
        die "Usage: bcraft $command [--nodeps] <package.bcraft>"
}


validate_sha256()
{
    local hash="$1"
    local context="$2"

    [ "$hash" != "AUTO" ] ||
        die "AUTO is only allowed with bcraft src-build ($context)"

    [[ "$hash" =~ ^[0-9A-Fa-f]{64}$ ]] ||
        die "Invalid SHA-256 for $context: $hash"
}


cmd_src_build()
{
    [ "$#" -le 1 ] ||
        die "Usage: bcraft src-build [recipe-dir]"

    local input_dir="${1:-.}"
    input_dir="$(readlink -f "$input_dir")"

    [ -d "$input_dir" ] || die "Recipe directory not found: $input_dir"
    [ -f "$input_dir/package.conf" ] || die "package.conf missing"
    [ -f "$input_dir/build.sh" ] || die "build.sh missing"

    local tmp copy_dir
    tmp="$(mktemp -d)"
    copy_dir="$tmp/recipe"
    cp -a -- "$input_dir" "$copy_dir"

    unset config_files depends source_urls source_files source_sha256s || true
    unset source_url source_file source_sha256 source_mode || true
    # shellcheck disable=SC1090
    source "$copy_dir/package.conf"

    : "${name:?name missing}"
    : "${version:?version missing}"
    : "${release:?release missing}"
    source_mode="${source_mode:-archive}"

    local -a auto_hashes=()
    local i hash url file downloaded

    case "$source_mode" in
        archive)
            if declare -p source_urls >/dev/null 2>&1; then
                declare -p source_files >/dev/null 2>&1 || die "source_files missing"
                declare -p source_sha256s >/dev/null 2>&1 || die "source_sha256s missing"
                [ "${#source_urls[@]}" -gt 0 ] || die "No sources defined"
                [ "${#source_urls[@]}" -eq "${#source_files[@]}" ] || die "source_urls/source_files length mismatch"
                [ "${#source_urls[@]}" -eq "${#source_sha256s[@]}" ] || die "source_urls/source_sha256s length mismatch"

                for i in "${!source_files[@]}"; do
                    file="${source_files[$i]}"
                    hash="${source_sha256s[$i]}"
                    url="${source_urls[$i]}"
                    [ -n "$file" ] || die "Empty source filename at index $i"
                    [ "$(basename -- "$file")" = "$file" ] || die "Invalid source filename: $file"
                    if [ "$hash" = "AUTO" ]; then
                        downloaded="$tmp/source-$i"
                        echo "Downloading $file for SHA-256"
                        wget -O "$downloaded" "$url"
                        auto_hashes+=("$(file_sha256 "$downloaded")")
                    elif ! [[ "$hash" =~ ^[0-9A-Fa-f]{64}$ ]]; then
                        die "Invalid SHA-256 for $file: $hash"
                    fi
                done
            else
                : "${source_url:?source_url missing}"
                : "${source_file:?source_file missing}"
                : "${source_sha256:?source_sha256 missing}"
                [ "$(basename -- "$source_file")" = "$source_file" ] || die "Invalid source filename: $source_file"
                if [ "$source_sha256" = "AUTO" ]; then
                    downloaded="$tmp/source-0"
                    echo "Downloading $source_file for SHA-256"
                    wget -O "$downloaded" "$source_url"
                    auto_hashes+=("$(file_sha256 "$downloaded")")
                elif ! [[ "$source_sha256" =~ ^[0-9A-Fa-f]{64}$ ]]; then
                    die "Invalid SHA-256 for $source_file: $source_sha256"
                fi
            fi
            ;;
        local)
            if declare -p source_sha256s >/dev/null 2>&1; then
                for hash in "${source_sha256s[@]}"; do
                    [ "$hash" != "AUTO" ] || die "AUTO is not supported for source_mode=local"
                done
            fi
            ;;
        recipe)
            ;;
        *) die "Unknown source mode: $source_mode" ;;
    esac

    if [ "${#auto_hashes[@]}" -gt 0 ]; then
        local hashes_file="$tmp/hashes"
        printf '%s\n' "${auto_hashes[@]}" > "$hashes_file"
        awk -v hf="$hashes_file" '
            BEGIN { n=0; while ((getline h < hf) > 0) hashes[++n]=h; close(hf); idx=1; in_array=0 }
            /^[[:space:]]*source_sha256[[:space:]]*=/ {
                if ($0 ~ /[\047\"]AUTO[\047\"]/) sub(/[\047\"]AUTO[\047\"]/, "\"" hashes[idx++] "\"")
                print; next
            }
            /^[[:space:]]*source_sha256s[[:space:]]*=\(/ { in_array=1; print; next }
            in_array {
                if ($0 ~ /^[[:space:]]*\)/) { in_array=0; print; next }
                if ($0 ~ /[\047\"]AUTO[\047\"]/) sub(/[\047\"]AUTO[\047\"]/, "\"" hashes[idx++] "\"")
                print; next
            }
            { print }
            END { if (idx-1 != n) exit 42 }
        ' "$copy_dir/package.conf" > "$copy_dir/package.conf.new" || {
            rm -rf "$tmp"
            die "Could not replace AUTO checksums in package.conf copy"
        }
        mv "$copy_dir/package.conf.new" "$copy_dir/package.conf"
    fi

    local package_dir_name="${name}-${version}-${release}"
    local stage="$tmp/stage"
    mkdir -p "$stage/$package_dir_name"
    cp -a -- "$copy_dir"/. "$stage/$package_dir_name/"

    local output="$PWD/${name}-${version}-${release}.src.bcraft"
    tar -czf "$output" -C "$stage" "$package_dir_name"
    rm -rf "$tmp"

    echo "Created $output"
}


cmd_build()
{
    [ "$#" -eq 1 ] ||
        die "Usage: bcraft build <package.src.bcraft>"

    local src_package
    src_package="$(readlink -f "$1")"

    [ -f "$src_package" ] ||
        die "Source package not found: $src_package"

    mkdir -p \
        "$BUILDROOT" \
        "$SOURCECACHE" \
        "$PACKAGECACHE"

    local recipe_tmp
    recipe_tmp="$(mktemp -d)"

    tar -xzf "$src_package" -C "$recipe_tmp"

    local recipe_dir
    recipe_dir="$(
        find "$recipe_tmp" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -print \
            -quit
    )"

    [ -n "$recipe_dir" ] || {
        rm -rf "$recipe_tmp"
        die "No recipe directory found"
    }

    [ -f "$recipe_dir/package.conf" ] || {
        rm -rf "$recipe_tmp"
        die "package.conf missing"
    }

    [ -x "$recipe_dir/build.sh" ] || {
        rm -rf "$recipe_tmp"
        die "build.sh missing or not executable"
    }

    # Reset optional recipe variables before sourcing a new recipe.
    unset config_files depends source_urls source_files source_sha256s || true

    # shellcheck disable=SC1090
    source "$recipe_dir/package.conf"

    : "${name:?name missing}"
    : "${version:?version missing}"
    : "${release:?release missing}"
    : "${arch:?arch missing}"
    : "${base:?base missing}"

    description="${description:-}"
    license="${license:-unknown}"
    maintainer="${maintainer:-}"
    source_mode="${source_mode:-archive}"

    # Normalize legacy single-source archive recipes to the multi-source model.
    # New recipes use source_urls/source_files/source_sha256s arrays.
    case "$source_mode" in
        archive)
            if ! declare -p source_urls >/dev/null 2>&1; then
                : "${source_url:?source_url missing}"
                : "${source_file:?source_file missing}"
                : "${source_sha256:?source_sha256 missing}"
                source_urls=("$source_url")
                source_files=("$source_file")
                source_sha256s=("$source_sha256")
            fi

            declare -p source_files >/dev/null 2>&1 || die "source_files missing"
            declare -p source_sha256s >/dev/null 2>&1 || die "source_sha256s missing"

            [ "${#source_urls[@]}" -gt 0 ] || die "No sources defined"
            [ "${#source_urls[@]}" -eq "${#source_files[@]}" ] || die "source_urls/source_files length mismatch"
            [ "${#source_urls[@]}" -eq "${#source_sha256s[@]}" ] || die "source_urls/source_sha256s length mismatch"
            ;;
        local)
            declare -p source_files >/dev/null 2>&1 || die "source_files missing"
            declare -p source_sha256s >/dev/null 2>&1 || die "source_sha256s missing"

            [ "${#source_files[@]}" -gt 0 ] || die "No sources defined"
            [ "${#source_files[@]}" -eq "${#source_sha256s[@]}" ] || die "source_files/source_sha256s length mismatch"
            ;;
        recipe)
            ;;
        *)
            rm -rf "$recipe_tmp"
            die "Unknown source mode: $source_mode"
            ;;
    esac

    check_arch "$arch"

    local workdir
    workdir="$BUILDROOT/${name}-${version}-${release}"

    rm -rf "$workdir"

    mkdir -p \
        "$workdir/src" \
        "$workdir/build" \
        "$workdir/pkg" \
        "$workdir/package/meta" \
        "$workdir/package/root"

    local srcdir=""
    local source_path=""
    local source_index source_name source_hash source_url_item
    local -a resolved_sources=()

    case "$source_mode" in
        archive)
            for source_index in "${!source_files[@]}"
            do
                source_name="${source_files[$source_index]}"
                source_hash="${source_sha256s[$source_index]}"
                source_url_item="${source_urls[$source_index]}"

                [ -n "$source_name" ] || die "Empty source filename at index $source_index"
                [ "$(basename -- "$source_name")" = "$source_name" ] || die "Invalid source filename: $source_name"

                validate_sha256 "$source_hash" "$source_name"
                source_path="$SOURCECACHE/$source_name"

                if [ ! -f "$source_path" ]; then
                    echo "Downloading $source_name"
                    wget -O "$source_path" "$source_url_item"
                fi

                echo "Checking source checksum: $source_name"
                echo "$source_hash  $source_path" | sha256sum -c -
                resolved_sources+=("$source_path")
            done
            ;;

        local)
            for source_index in "${!source_files[@]}"
            do
                source_name="${source_files[$source_index]}"
                source_hash="${source_sha256s[$source_index]}"

                [ -n "$source_name" ] || die "Empty source filename at index $source_index"
                [ "$(basename -- "$source_name")" = "$source_name" ] || die "Invalid source filename: $source_name"

                source_path="$recipe_dir/sources/$source_name"
                [ -f "$source_path" ] || die "Local source missing: sources/$source_name"

                validate_sha256 "$source_hash" "$source_name"
                echo "Checking source checksum: $source_name"
                echo "$source_hash  $source_path" | sha256sum -c -
                resolved_sources+=("$source_path")
            done
            ;;

        recipe)
            srcdir="$recipe_dir"
            ;;
    esac

    if [ "$source_mode" = "archive" ] || [ "$source_mode" = "local" ]; then
        echo "Extracting primary source: ${source_files[0]}"
        tar -xf "${resolved_sources[0]}" -C "$workdir/src"

        srcdir="$(
            find "$workdir/src" \
                -mindepth 1 \
                -maxdepth 1 \
                -type d \
                -print \
                -quit
        )"

        [ -n "$srcdir" ] || {
            rm -rf "$recipe_tmp"
            die "Could not determine source directory"
        }

        # Additional sources are intentionally not unpacked.  Make them
        # available by their declared filenames in SRCDIR for build.sh.
        for ((source_index=1; source_index<${#resolved_sources[@]}; source_index++))
        do
            cp -f -- "${resolved_sources[$source_index]}" "$srcdir/${source_files[$source_index]}"
        done
    fi

    export PKGNAME="$name"
    export PKGVER="$version"
    export PKGRELEASE="$release"

    export RECIPE_DIR="$recipe_dir"

    export WORKDIR="$workdir"
    export SRCDIR="$srcdir"
    export BUILDDIR="$workdir/build"
    export PKGDIR="$workdir/pkg"

    export JOBS="${JOBS:-$(nproc)}"

    echo
    echo "Building $name $version-$release"
    echo
    echo "Source : $SRCDIR"
    echo "Build  : $BUILDDIR"
    echo "Package: $PKGDIR"
    echo

    "$recipe_dir/build.sh"

    if [ -z "$(find "$PKGDIR" -mindepth 1 -print -quit)" ]; then
        rm -rf "$recipe_tmp"
        die "Package staging directory is empty"
    fi

    echo "Creating manifest"

    local path rel type hash

    while IFS= read -r -d '' path
    do
        rel="${path#"$PKGDIR"/}"
        hash="-"

        if [ -L "$path" ]; then
            type="l"

        elif [ -d "$path" ]; then
            type="d"

        elif [ -f "$path" ]; then
            if is_config_path "$rel"; then
                type="c"
                hash="$(file_sha256 "$path")"
            else
                type="f"
                hash="-"
            fi

        else
            # Skip special filesystem objects in this minimal implementation.
            continue
        fi

        printf '%s\t%s\t%s\n' \
            "$type" "$hash" "$rel"

    done < <(
        find "$PKGDIR" \
            -mindepth 1 \
            -print0 |
        LC_ALL=C sort -z
    ) > "$workdir/package/meta/MANIFEST"

    {
        echo "name=$name"
        echo "version=$version"
        echo "release=$release"
        echo "arch=$arch"
        echo "base=$base"
        echo "description=$description"
        echo "license=$license"

        if [ -n "$maintainer" ]; then
            echo "maintainer=$maintainer"
        fi

        if declare -p depends >/dev/null 2>&1; then
            local dependency

            for dependency in "${depends[@]}"
            do
                validate_dependency_name "$dependency" || {
                    rm -rf "$recipe_tmp"
                    die "Invalid dependency name: $dependency"
                }

                echo "depend=$dependency"
            done
        fi

        echo "source_mode=$source_mode"

        if [ "$source_mode" = "archive" ]; then
            for source_index in "${!source_files[@]}"
            do
                echo "source=${source_urls[$source_index]}"
                echo "source_file=${source_files[$source_index]}"
                echo "source_sha256=${source_sha256s[$source_index]}"
            done
        elif [ "$source_mode" = "local" ]; then
            for source_index in "${!source_files[@]}"
            do
                echo "source_file=${source_files[$source_index]}"
                echo "source_sha256=${source_sha256s[$source_index]}"
            done
        fi
    } > "$workdir/package/meta/PKGINFO"

    cp -a \
        "$PKGDIR"/. \
        "$workdir/package/root/"

    local package_name
    local package_path

    package_name="${name}-${version}-${release}.bcraft"
    package_path="$PACKAGECACHE/$package_name"

    echo "Creating binary package"

    tar \
        -czf "$package_path" \
        -C "$workdir/package" \
        meta \
        root

    (
        cd "$PACKAGECACHE"

        sha256sum "$package_name" \
            > "${package_name}.sha256"
    )

    rm -rf "$recipe_tmp"

    echo
    echo "Binary package created:"
    echo
    echo "  $package_path"
    echo
}



# Compare two version/release strings using natural numeric/alphabetic segments.
# Prints -1 when A < B, 0 when equal, 1 when A > B.
version_compare()
{
    local a="$1"
    local b="$2"

    python3 - "$a" "$b" <<'PYVERSION'
import re, sys

def tokens(value):
    return re.findall(r'[0-9]+|[A-Za-z]+', value)

def cmp(a, b):
    ta, tb = tokens(a), tokens(b)
    for x, y in zip(ta, tb):
        if x.isdigit() and y.isdigit():
            xi, yi = int(x), int(y)
            if xi != yi:
                return 1 if xi > yi else -1
        elif x.isdigit() != y.isdigit():
            # Numeric release/version components sort after alphabetic qualifiers.
            return 1 if x.isdigit() else -1
        else:
            xl, yl = x.lower(), y.lower()
            if xl != yl:
                return 1 if xl > yl else -1
    if len(ta) != len(tb):
        return 1 if len(ta) > len(tb) else -1
    return 0

print(cmp(sys.argv[1], sys.argv[2]))
PYVERSION
}

package_version_compare()
{
    local new_version="$1" new_release="$2" old_version="$3" old_release="$4"
    local result
    result="$(version_compare "$new_version" "$old_version")"
    if [ "$result" -ne 0 ]; then
        echo "$result"
    else
        version_compare "$new_release" "$old_release"
    fi
}

confirm_update()
{
    local name="$1" old="$2" new="$3" answer
    local lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"

    if [[ "$lang" == de* ]]; then
        printf '%s %s ist bereits installiert.\n' "$name" "$old"
        printf 'Das angegebene Paket enthält %s %s.\n\n' "$name" "$new"
        printf 'Möchten Sie das bereits installierte Paket aktualisieren? [j/N] '
        IFS= read -r answer || answer=""
        case "$answer" in j|J|ja|JA|Ja) return 0 ;; *) return 1 ;; esac
    else
        printf '%s %s is already installed.\n' "$name" "$old"
        printf 'The specified package contains %s %s.\n\n' "$name" "$new"
        printf 'Do you want to update the installed package? [y/N] '
        IFS= read -r answer || answer=""
        case "$answer" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
    fi
}

cmd_install()
{
    require_root

    parse_package_command_args install "$@"

    local package
    package="$(readlink -f "$PACKAGE_ARG")"

    [ -f "$package" ] ||
        die "Package not found: $package"

    local tmpdir
    tmpdir="$(mktemp -d)"

    if [ -f "${package}.sha256" ]; then
        (
            cd "$(dirname "$package")"

            sha256sum \
                -c "$(basename "${package}.sha256")"
        )
    fi

    tar -xzf "$package" -C "$tmpdir"

    local pkginfo="$tmpdir/meta/PKGINFO"
    local manifest="$tmpdir/meta/MANIFEST"
    local payload="$tmpdir/root"

    [ -f "$pkginfo" ] || {
        rm -rf "$tmpdir"
        die "PKGINFO missing"
    }

    [ -f "$manifest" ] || {
        rm -rf "$tmpdir"
        die "MANIFEST missing"
    }

    [ -d "$payload" ] || {
        rm -rf "$tmpdir"
        die "Package payload missing"
    }

    local name version release arch base

    name="$(metadata "$pkginfo" name)"
    version="$(metadata "$pkginfo" version)"
    release="$(metadata "$pkginfo" release)"
    arch="$(metadata "$pkginfo" arch)"
    base="$(metadata "$pkginfo" base)"

    [ -n "$name" ] || {
        rm -rf "$tmpdir"
        die "Package name missing"
    }

    check_arch "$arch"
    check_base "$base"

    local dbdir="$DBROOT/$name"

    mkdir -p "$DBROOT"

    if [ -e "$dbdir" ] && [ "$NODEPS" -eq 0 ]; then
        local old_pkginfo="$dbdir/PKGINFO"
        [ -f "$old_pkginfo" ] || {
            rm -rf "$tmpdir"
            die "Installed PKGINFO missing for $name"
        }

        local old_version old_release comparison
        old_version="$(metadata "$old_pkginfo" version)"
        old_release="$(metadata "$old_pkginfo" release)"
        comparison="$(package_version_compare "$version" "$release" "$old_version" "$old_release")"

        case "$comparison" in
            1)
                if confirm_update "$name" "$old_version-$old_release" "$version-$release"; then
                    rm -rf "$tmpdir"
                    if [ "$NODEPS" -eq 1 ]; then
                        cmd_update --nodeps "$package"
                    else
                        cmd_update "$package"
                    fi
                    return
                fi
                rm -rf "$tmpdir"
                echo "bcraft: Update cancelled" >&2
                return 1
                ;;
            0)
                rm -rf "$tmpdir"
                die "$name $version-$release is already installed"
                ;;
            -1)
                rm -rf "$tmpdir"
                die "$name $old_version-$old_release is newer than $version-$release; downgrade refused"
                ;;
            *)
                rm -rf "$tmpdir"
                die "Could not compare package versions"
                ;;
        esac
    fi

    check_dependencies "$pkginfo" "$name" "$NODEPS" || {
        rm -rf "$tmpdir"
        exit 1
    }

    local type hash path

    while IFS=$'\t' read -r type hash path
    do
        validate_package_path "$path" || {
            rm -rf "$tmpdir"
            die "Invalid package path: $path"
        }

        case "$type" in
            f|c|l)
                if [ "$NODEPS" -eq 0 ] && { [ -e "/$path" ] || [ -L "/$path" ]; }; then
                    rm -rf "$tmpdir"
                    die "File already exists: /$path"
                fi
                ;;
        esac

    done < <(normalize_manifest "$manifest")

    echo "Installing $name $version-$release"

    cp -a \
        "$payload"/. \
        /

    mkdir -p "$dbdir"

    cp "$pkginfo" \
        "$dbdir/PKGINFO"

    cp "$manifest" \
        "$dbdir/MANIFEST"

    rm -rf "$tmpdir"

    echo "$name $version-$release installed"
}


cmd_update()
{
    require_root

    parse_package_command_args update "$@"

    local package
    package="$(readlink -f "$PACKAGE_ARG")"

    [ -f "$package" ] ||
        die "Package not found: $package"

    local tmpdir
    tmpdir="$(mktemp -d)"

    if [ -f "${package}.sha256" ]; then
        (
            cd "$(dirname "$package")"

            sha256sum \
                -c "$(basename "${package}.sha256")"
        )
    fi

    tar -xzf "$package" -C "$tmpdir"

    local pkginfo="$tmpdir/meta/PKGINFO"
    local new_manifest="$tmpdir/meta/MANIFEST"
    local payload="$tmpdir/root"

    [ -f "$pkginfo" ] || {
        rm -rf "$tmpdir"
        die "PKGINFO missing"
    }

    [ -f "$new_manifest" ] || {
        rm -rf "$tmpdir"
        die "MANIFEST missing"
    }

    [ -d "$payload" ] || {
        rm -rf "$tmpdir"
        die "Package payload missing"
    }

    local name version release arch base

    name="$(metadata "$pkginfo" name)"
    version="$(metadata "$pkginfo" version)"
    release="$(metadata "$pkginfo" release)"
    arch="$(metadata "$pkginfo" arch)"
    base="$(metadata "$pkginfo" base)"

    [ -n "$name" ] || {
        rm -rf "$tmpdir"
        die "Package name missing"
    }

    check_arch "$arch"
    check_base "$base"

    local dbdir="$DBROOT/$name"
    local old_pkginfo="$dbdir/PKGINFO"
    local old_manifest="$dbdir/MANIFEST"

    [ -d "$dbdir" ] || {
        rm -rf "$tmpdir"
        die "$name is not installed"
    }

    [ -f "$old_pkginfo" ] || {
        rm -rf "$tmpdir"
        die "Installed PKGINFO missing for $name"
    }

    [ -f "$old_manifest" ] || {
        rm -rf "$tmpdir"
        die "Installed MANIFEST missing for $name"
    }

    local old_name old_version old_release

    old_name="$(metadata "$old_pkginfo" name)"
    old_version="$(metadata "$old_pkginfo" version)"
    old_release="$(metadata "$old_pkginfo" release)"

    [ "$name" = "$old_name" ] || {
        rm -rf "$tmpdir"
        die "Package name mismatch: installed $old_name, new $name"
    }

    check_dependencies "$pkginfo" "$name" "$NODEPS" || {
        rm -rf "$tmpdir"
        exit 1
    }

    local type hash path old_entry old_type old_hash

    #
    # Validate paths, type changes and conflicts introduced by new files.
    #
    while IFS=$'\t' read -r type hash path
    do
        validate_package_path "$path" || {
            rm -rf "$tmpdir"
            die "Invalid package path: $path"
        }

        old_entry="$(manifest_lookup "$old_manifest" "$path")"

        if [ -n "$old_entry" ]; then
            IFS=$'\t' read -r old_type old_hash _ <<< "$old_entry"

            if [ "$old_type" != "$type" ]; then
                rm -rf "$tmpdir"
                die "Path type changed for /$path ($old_type -> $type); use remove/install"
            fi

        else
            case "$type" in
                f|c|l)
                    if [ -e "/$path" ] || [ -L "/$path" ]; then
                        rm -rf "$tmpdir"
                        die "New package file conflicts with existing path: /$path"
                    fi
                    ;;
            esac
        fi

    done < <(normalize_manifest "$new_manifest")

    echo "Updating $name $old_version-$old_release -> $version-$release"

    #
    # Move new configuration files out of the bulk payload.
    # They are handled individually below.
    #
    local config_stage="$tmpdir/new-config"
    mkdir -p "$config_stage"

    while IFS=$'\t' read -r type hash path
    do
        [ "$type" = "c" ] || continue

        if [ -f "$payload/$path" ]; then
            mkdir -p "$config_stage/$(dirname "$path")"
            cp -a "$payload/$path" "$config_stage/$path"
            rm -f "$payload/$path"
        fi

    done < <(normalize_manifest "$new_manifest")

    #
    # Install/overwrite all normal payload files.
    #
    # bcraft is a special case when it updates itself.  Overwriting the
    # currently running /usr/bin/bcraft in place can confuse bash because
    # the interpreter may still be reading commands from that file.
    #
    # Therefore, remove the new bcraft binary from the bulk payload, copy
    # the remaining payload normally, and finally replace /usr/bin/bcraft
    # atomically with rename(2) via mv.  The running process keeps reading
    # the old inode while subsequent invocations see the new file.
    #
    local self_update_source=""

    if [ "$name" = "bcraft" ] &&
       [ -f "$payload/usr/bin/bcraft" ]; then

        self_update_source="$tmpdir/bcraft-self-update"

        cp -a \
            "$payload/usr/bin/bcraft" \
            "$self_update_source"

        rm -f -- "$payload/usr/bin/bcraft"
    fi

    cp -a \
        "$payload"/. \
        /

    if [ -n "$self_update_source" ]; then
        local self_update_tmp="/usr/bin/.bcraft.new.$$"

        rm -f -- "$self_update_tmp"

        cp -a \
            "$self_update_source" \
            "$self_update_tmp"

        mv -f -- \
            "$self_update_tmp" \
            /usr/bin/bcraft
    fi

    #
    # Handle configuration files.
    #
    while IFS=$'\t' read -r type hash path
    do
        [ "$type" = "c" ] || continue

        local new_config="$config_stage/$path"
        local target="/$path"

        [ -f "$new_config" ] || continue

        old_entry="$(manifest_lookup "$old_manifest" "$path")"

        if [ -z "$old_entry" ]; then
            mkdir -p "$(dirname "$target")"
            cp -a "$new_config" "$target"
            continue
        fi

        IFS=$'\t' read -r old_type old_hash _ <<< "$old_entry"

        if [ ! -e "$target" ]; then
            mkdir -p "$(dirname "$target")"
            cp -a "$new_config" "$target"
            continue
        fi

        #
        # If we know the old package hash and the current file still has
        # exactly that hash, the administrator has not modified it.
        #
        if [ "$old_hash" != "-" ] &&
           [ "$(file_sha256 "$target")" = "$old_hash" ]; then

            cp -a "$new_config" "$target"

        else
            #
            # Modified config or legacy manifest without an old hash:
            # keep the local version and place the new package version next
            # to it.
            #
            cp -a "$new_config" "${target}.bcraft-new"

            echo "Preserving modified config: $target"
            echo "New package config written to: ${target}.bcraft-new"
        fi

    done < <(normalize_manifest "$new_manifest")

    #
    # Remove paths that existed in the old package but no longer exist
    # in the new package.
    #
    while IFS=$'\t' read -r type hash path
    do
        if manifest_has "$new_manifest" "$path"; then
            continue
        fi

        case "$type" in
            f|l)
                rm -f -- "/$path"
                ;;

            c)
                #
                # Remove an obsolete config only when it is provably
                # unmodified. Otherwise preserve it as local state.
                #
                if [ -f "/$path" ] &&
                   [ "$hash" != "-" ] &&
                   [ "$(file_sha256 "/$path")" = "$hash" ]; then

                    rm -f -- "/$path"

                elif [ -e "/$path" ]; then
                    echo "Preserving obsolete modified config: /$path"
                fi
                ;;
        esac

    done < <(normalize_manifest "$old_manifest")

    #
    # Remove obsolete empty directories in reverse order.
    #
    normalize_manifest "$old_manifest" |
    tac |
    while IFS=$'\t' read -r type hash path
    do
        if [ "$type" = "d" ] &&
           ! manifest_has "$new_manifest" "$path"; then

            rmdir -- "/$path" 2>/dev/null || true
        fi
    done

    cp "$pkginfo" "$dbdir/PKGINFO"
    cp "$new_manifest" "$dbdir/MANIFEST"

    rm -rf "$tmpdir"

    echo "$name updated to $version-$release"
}


cmd_remove()
{
    require_root

    [ "$#" -eq 1 ] ||
        die "Usage: bcraft remove <package>"

    local name="$1"

    local dbdir="$DBROOT/$name"
    local manifest="$dbdir/MANIFEST"

    [ -d "$dbdir" ] ||
        die "$name is not installed"

    [ -f "$manifest" ] ||
        die "Manifest missing for $name"

    echo "Removing $name"

    local type hash path

    while IFS=$'\t' read -r type hash path
    do
        case "$type" in
            f|l)
                rm -f -- "/$path"
                ;;

            c)
                if [ ! -e "/$path" ]; then
                    continue
                fi

                if [ "$hash" != "-" ] &&
                   [ "$(file_sha256 "/$path")" = "$hash" ]; then

                    rm -f -- "/$path"

                else
                    echo "Preserving modified config: /$path"
                fi
                ;;
        esac

    done < <(normalize_manifest "$manifest")

    normalize_manifest "$manifest" |
    tac |
    while IFS=$'\t' read -r type hash path
    do
        if [ "$type" = "d" ]; then
            rmdir -- "/$path" 2>/dev/null || true
        fi
    done

    rm -rf "$dbdir"

    echo "$name removed"
}


cmd_list()
{
    if [ ! -d "$DBROOT" ]; then
        return
    fi

    local dir

    for dir in "$DBROOT"/*
    do
        [ -d "$dir" ] ||
            continue

        local pkginfo="$dir/PKGINFO"

        if [ -f "$pkginfo" ]; then
            local name
            local version
            local release

            name="$(metadata "$pkginfo" name)"
            version="$(metadata "$pkginfo" version)"
            release="$(metadata "$pkginfo" release)"

            printf '%-25s %s-%s\n' \
                "$name" \
                "$version" \
                "$release"
        fi
    done
}


cmd_info()
{
    [ "$#" -eq 1 ] ||
        die "Usage: bcraft info <package>"

    local pkginfo="$DBROOT/$1/PKGINFO"

    [ -f "$pkginfo" ] ||
        die "$1 is not installed"

    cat "$pkginfo"
}


if [ "$#" -lt 1 ]; then
    usage
    exit 1
fi

command="$1"
shift

case "$command" in
    build)
        cmd_build "$@"
        ;;

    src-build)
        cmd_src_build "$@"
        ;;

    install)
        cmd_install "$@"
        ;;

    update)
        cmd_update "$@"
        ;;

    remove)
        cmd_remove "$@"
        ;;

    list)
        cmd_list "$@"
        ;;

    info)
        cmd_info "$@"
        ;;

    -v|--version|version)
        version
        ;;

    -h|--help|help)
        usage
        ;;

    *)
        die "Unknown command: $command"
        ;;
esac
